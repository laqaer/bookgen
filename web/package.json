{
  "name": "gildroot-web",
  "private": true,
  "type": "module",
  "description": "Gildroot site and studio. No build step for the app; dev dependencies are for tests only.",
  "scripts": {
    "build": "node build.mjs",
    "serve": "node build.mjs --serve",
    "test:charts": "node test/charts/scene-smoke.mjs",
    "test": "node test/run-all.mjs",
    "test:engine": "node --test test/engine/",
    "test:matrix": "node test/charts/run.mjs"
  },
  "devDependencies": {
    "pdfkit": "0.20.2",
    "playwright": "1.56.1"
  }
}
